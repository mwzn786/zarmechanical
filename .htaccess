# Hostinger / LiteSpeed — static site routing
# Upload this file to public_html (alongside index.html).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use www — the apex URL is stuck on a stale CDN copy of WordPress
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.zarmechanical.com/$1 [L,R=301]

  # Old WordPress pretty permalinks → static pages
  RewriteRule ^about/?$ /about.html [R=301,L]
  RewriteRule ^services/?$ /services.html [R=301,L]
  RewriteRule ^projects/?$ /projects.html [R=301,L]
  RewriteRule ^safety/?$ /safety.html [R=301,L]
  RewriteRule ^contact/?$ /contact.html [R=301,L]
  RewriteRule ^contacts/?$ /contact.html [R=301,L]
</IfModule>
